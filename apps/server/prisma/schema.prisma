// Schéma de données. Voir docs/protocol.md pour l'état de partie, qui vit en mémoire
// et n'est persisté que par snapshots et journal.
//
// Note de propriété intellectuelle : la table Card ne stocke AUCUN texte de règles
// (pas d'oracle text, pas de flavor text) et aucune image. Seules des métadonnées
// d'identification et les URLs d'images Scryfall, que le navigateur du client va
// chercher lui-même.

generator client {
  provider = "prisma-client-js"
  // L'image d'exécution est une Debian bookworm (OpenSSL 3.0). Sans cette cible
  // explicite, le moteur généré ne correspond pas à celui attendu au démarrage.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeckSource {
  MANUAL
  ARCHIDEKT
  MOXFIELD
  TEXT
}

enum DeckZone {
  MAIN
  COMMANDER
  SIDEBOARD
}

enum GameMode {
  COMMANDER
  DUEL
  PLANECHASE
  DRAFT
}

enum RoomStatus {
  LOBBY
  PLAYING
  ENDED
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  displayName     String    @unique
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  sessions   Session[]
  decks      Deck[]
  playmats   Playmat[]
  prefs      UserPrefs?
  authTokens AuthToken[]
  rooms      GameRoom[]  @relation("HostedRooms")
  seats      GameSeat[]

  @@index([lastSeenAt])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Jetons à usage unique, stockés hachés : vérification d'email, réinitialisation.
model AuthToken {
  id        String       @id @default(uuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Deck {
  id            String     @id @default(uuid())
  userId        String
  name          String
  format        String?
  source        DeckSource @default(MANUAL)
  sourceUrl     String?
  sourceDeckId  String?
  lastSyncedAt  DateTime?
  /// Tapis et dos de carte propres à ce deck : ils s'appliquent au siège quand on
  /// le charge. Ils nous appartiennent, pas à la source externe — une
  /// resynchronisation ne les efface donc jamais.
  playmatUrl    String?
  cardBackUrl   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     DeckCard[]
  snapshots DeckSnapshot[]

  @@unique([userId, source, sourceDeckId], name: "user_source_deck")
  @@index([userId, updatedAt])
}

model DeckCard {
  id                      String   @id @default(uuid())
  deckId                  String
  scryfallId              String
  quantity                Int
  zone                    DeckZone @default(MAIN)
  requestedSetCode        String?
  requestedCollectorNumber String?
  isFoil                  Boolean  @default(false)
  sortIndex               Int      @default(0)

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [scryfallId], references: [scryfallId])

  @@index([deckId, zone, sortIndex])
  @@index([scryfallId])
}

/// Alimentée par le bulk `default_cards` de Scryfall. Voir src/cards/ingest.ts.
model Card {
  scryfallId      String   @id
  oracleId        String?
  name            String
  /// Nom en minuscules sans diacritiques ni ponctuation typographique : clé de résolution.
  normalizedName  String
  setCode         String
  setName         String
  /// Type d'édition Scryfall : départage les impressions par défaut (voir printingScore).
  setType         String   @default("expansion")
  collectorNumber String
  typeLine        String
  manaCost        String?
  cmc             Float    @default(0)
  colorIdentity   String[]
  colors          String[]
  layout          String
  rarity          String
  imageUris       Json?
  /// Faces des cartes recto-verso : nom + imageUris par face, sans texte de règles.
  faces           Json?
  isToken         Boolean  @default(false)
  isPromo         Boolean  @default(false)
  isDigital       Boolean  @default(false)
  isVariation     Boolean  @default(false)
  isFullArt       Boolean  @default(false)
  hasFoil         Boolean  @default(false)
  hasNonFoil      Boolean  @default(true)
  lang            String   @default("en")
  borderColor     String   @default("black")
  /// L'identifiant de l'**œuvre** chez Scryfall (`illustration_id`), et non de
  /// l'impression : deux impressions qui le partagent portent exactement la même
  /// illustration.
  ///
  /// C'est le signal décisif pour choisir une impression **ressemblante** quand
  /// il faut en substituer une dans la langue du joueur : une édition française
  /// de *son* illustration vaut mieux qu'une édition de meilleure qualité d'une
  /// autre œuvre. Voir `chooseSubstitute` dans `src/cards/localization.ts`.
  ///
  /// **Cartes recto-verso :** Scryfall ne publie pas ce champ au premier niveau,
  /// il en pose un **par face**. On retient ici celui du **recto** — l'œuvre que
  /// le joueur voit et choisit — et la comparaison accepte n'importe quelle face
  /// du candidat (`illustrationIdsOf`). Aucun faux positif n'en découle : deux
  /// impressions qui partagent un identifiant partagent bien l'œuvre.
  ///
  /// **Nullable, et il faut que ça reste propre.** Les lignes ingérées avant
  /// l'ajout de la colonne valent `null` : on ne peut alors rien comparer, et le
  /// classement retombe exactement sur la règle d'avant (qualité, puis score
  /// d'impression, puis date, puis identifiant). Une prochaine ingestion du bulk
  /// les remplit toutes ; `prisma db push` ajoute la colonne sans rien détruire.
  illustrationId  String?
  /// `frame` de Scryfall : `1993`, `1997`, `2003`, `2015`, `future`. À œuvre
  /// égale — ou à défaut d'œuvre commune — une carte du même cadre ressemble
  /// davantage à celle que le joueur a choisie. `null` = pas encore ingéré.
  frame           String?
  /// `frame_effects` de Scryfall (`showcase`, `extendedart`, `legendary`…).
  /// Json plutôt que `String[]` pour distinguer « aucun effet » de « pas encore
  /// ingéré » : une liste vide ne sait pas dire qu'elle est vide par ignorance.
  frameEffects    Json?
  /// `textless` de Scryfall. Nullable pour la même raison que `frameEffects`.
  isTextless      Boolean?
  releasedAt      DateTime?
  power           String?
  toughness       String?
  loyalty         String?
  /// Indice de préférence pour le choix d'édition par défaut (calculé à l'ingestion).
  printingScore   Int      @default(0)
  updatedAt       DateTime @default(now())

  deckCards     DeckCard[]
  localizations CardLocalization[]

  @@index([normalizedName])
  @@index([oracleId])
  @@index([setCode, collectorNumber])
  @@index([isToken])
  @@index([releasedAt])
}

/// Impression localisée d'une carte du catalogue.
///
/// Scryfall ne publie pas « la même carte avec une autre image » : chaque
/// traduction est un **objet carte distinct**, de même édition et même numéro de
/// collection mais d'identifiant différent, avec son `printed_name` et ses
/// propres `image_uris`. Résoudre la langue, c'est donc retrouver cette autre
/// carte — ce que cette table mémorise, une fois, par (carte d'origine, langue).
///
/// Même invariant de droits que `Card` : on stocke des **URL** et des
/// métadonnées d'identification. Aucune image n'est téléchargée, mise en cache
/// ni servie par nous ; le navigateur du joueur va la chercher chez Scryfall.
model CardLocalization {
  /// L'identifiant que transporte le protocole de jeu : la carte telle qu'elle a
  /// été choisie, en anglais dans notre catalogue.
  scryfallId          String
  language            String
  /// L'impression traduite chez Scryfall. `null` quand il n'y en a pas.
  localizedScryfallId String?
  /// `printed_name` : le nom tel qu'il est imprimé sur la carte traduite.
  ///
  /// Renseigné **même quand `missing` est vrai** : cette impression-là n'existe
  /// pas dans la langue demandée, mais la carte y a souvent un nom, repris d'une
  /// autre impression. On affiche alors le nom traduit sous l'illustration que le
  /// joueur a choisie, sans changer l'illustration.
  printedName         String?
  imageUris           Json?
  /// Même forme que `Card.faces` : une image par face, sans texte de règles.
  faces               Json?
  /// `image_status` de Scryfall : `missing`, `placeholder`, `lowres` ou
  /// `highres_scan`. Les impressions non anglaises sont très souvent `lowres` :
  /// l'URL `large` existe et fait bien 672 × 936, mais elle est agrandie depuis un
  /// scan de basse définition. Sans ce champ, le client ne peut pas savoir qu'il
  /// remplace une image nette par un ersatz.
  imageStatus         String?
  /// `highres_image` de Scryfall, le même fait sous forme de booléen.
  highresImage        Boolean  @default(false)
  /// Vrai quand le nom traduit a été cherché — trouvé ou non.
  ///
  /// Sans ce drapeau, une carte sans nom traduit serait recherchée à chaque
  /// passage, puisqu'on ne saurait pas distinguer « pas encore cherché » de
  /// « cherché, rien trouvé ».
  ///
  /// **Il ne décide plus de rien à lui seul.** Il répond à une question — le
  /// nom — et une seule ; c'est `substituteSearchVersion` qui répond à l'autre.
  /// Les avoir confondus est précisément ce qui a verrouillé la substitution
  /// sur les lignes écrites avant elle. On le garde renseigné parce qu'il dit
  /// quelque chose de vrai, mais la décision de rechercher se lit désormais sur
  /// le compteur.
  nameChecked         Boolean  @default(false)
  /// Vrai quand Scryfall a répondu 404, c'est-à-dire « jamais imprimée dans
  /// cette langue ». Ce n'est pas une erreur, c'est le repli anglais — et il est
  /// mémorisé, sinon chaque affichage rejouerait l'appel pour rien.
  missing             Boolean  @default(false)

  /// ——— L'impression de substitution ———————————————————————————————————
  ///
  /// Une **autre** impression de la même carte, celle-là traduite. Elle est
  /// retenue en même temps que `printedName`, par la même recherche `oracleid`,
  /// et pour la même raison : sur un deck réel, 27 des 29 impressions qui
  /// rendent 404 ont une soeur française ailleurs.
  ///
  /// **Elle ne remplace rien par défaut.** L'illustration est un choix du
  /// joueur (`requestedSetCode` / `requestedCollectorNumber`) ; la changer
  /// d'office ferait voir deux images différentes à deux joueurs de la même
  /// table. Ces colonnes ne sont lues que si le joueur a coché l'option
  /// `UserPrefs.forceLocalizedPrinting`, et le choix reste **purement local** :
  /// le `scryfallId` du protocole n'en dépend jamais.
  ///
  /// Colonnes nullables sans valeur imposée : `prisma db push` les ajoute sans
  /// rien détruire, et une ligne écrite avant leur existence reste valide —
  /// elle n'a simplement pas de substitution, ce qui est le comportement d'hier.
  substituteScryfallId       String?
  /// L'édition de la substitution, pour que l'interface puisse **dire** laquelle.
  substituteSetCode          String?
  substituteCollectorNumber  String?
  /// Des URL, comme partout : aucun octet d'image n'est stocké ici.
  substituteImageUris        Json?
  /// Même forme que `Card.faces` : une image par face, sans texte de règles.
  substituteFaces            Json?
  substituteImageStatus      String?
  substituteHighresImage     Boolean  @default(false)
  /// La version de la recherche de substitution qui a **réellement** été menée
  /// sur cette ligne.
  ///
  /// **Pourquoi un compteur et pas un booléen de plus.** `nameChecked` répond à
  /// « a-t-on cherché un nom ailleurs ? ». Il a été écrit `true` sur des
  /// centaines de lignes à une époque où la recherche ne rapportait **que** le
  /// nom : ces lignes n'ont aucune substitution, et le drapeau — conçu comme un
  /// garde-fou anti-boucle — les avait transformées en verrou définitif.
  /// Mesuré : 669 lignes « déjà cherchées » pour 10 substitutions.
  ///
  /// Un entier dit ce qu'un booléen ne peut pas dire : **quelle** recherche a
  /// été faite. `0` — la valeur des lignes d'avant — signifie « jamais cherché
  /// de substitution », et ces lignes repassent une fois. Une ligne portant la
  /// version courante a été cherchée : si elle n'a pas de substitution, c'est
  /// qu'il n'y en a pas, et on ne la rouvre plus — le garde-fou tient. Le jour
  /// où la règle de choix changera, monter la constante suffira à rejouer le
  /// rattrapage sans toucher une seule ligne à la main.
  ///
  /// Une **panne** n'incrémente jamais ce compteur : seule une réponse de
  /// Scryfall — trouvée ou 404 — écrit la ligne. Un 503 laisse le `0` en place
  /// et la carte repasse plus tard.
  ///
  /// Colonne entière à valeur par défaut : `prisma db push` l'ajoute sans rien
  /// détruire, et toute ligne existante hérite de `0`, c'est-à-dire « à faire ».
  substituteSearchVersion    Int      @default(0)

  fetchedAt           DateTime @default(now())

  card Card @relation(fields: [scryfallId], references: [scryfallId], onDelete: Cascade)

  @@id([scryfallId, language])
  @@index([language, missing])
  /// Le rattrapage lit exactement ces trois colonnes pour trouver ce qui reste
  /// à faire : sans cet index il balaierait toute la table à chaque tranche.
  @@index([language, missing, substituteSearchVersion])
}

model Playmat {
  id       String @id @default(uuid())
  userId   String
  name     String
  imageUrl String

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefs UserPrefs[]

  @@index([userId])
}

model UserPrefs {
  userId           String  @id
  defaultPlaymatId String?
  cardBackUrl      String?
  autoUntapStep    Boolean @default(true)
  uiScale          Float   @default(1)
  /// Langue de l'interface et des cartes, code ISO 639-1 pris dans `LANGUAGES`
  /// (packages/shared/src/i18n/language.ts, source unique partagée avec le client).
  /// Colonne à valeur par défaut plutôt que type énuméré Postgres : ajouter une
  /// langue reste alors une ligne de code, sans ALTER TYPE sur la base de prod.
  /// Les lignes déjà présentes héritent du français, ce qu'elles voyaient déjà.
  language         String  @default("fr")
  /// Afficher l'illustration d'une **autre** impression quand celle que le joueur
  /// a choisie n'existe pas dans sa langue.
  ///
  /// Refusé par défaut, et ce défaut est un choix : l'illustration est une
  /// décision du joueur (`requestedSetCode` / `requestedCollectorNumber`), et la
  /// changer d'office ferait voir deux images différentes à deux joueurs de la
  /// même table tout en rendant le sélecteur d'impression menteur. L'option lève
  /// la règle **pour celui qui la coche**, et pour lui seul : c'est un réglage
  /// d'affichage, rien de ce qui part au serveur ni de ce que voient les autres
  /// n'en dépend.
  ///
  /// Booléen à valeur par défaut, comme `autoUntapStep` : `prisma db push`
  /// l'ajoute sans rien détruire, et les lignes déjà présentes héritent de
  /// `false`, c'est-à-dire du comportement que leurs propriétaires avaient déjà.
  forceLocalizedPrinting Boolean @default(false)
  /// Réglages d'interface libres (raccourcis personnalisés, panneaux repliés…).
  extra            Json?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultPlaymat  Playmat? @relation(fields: [defaultPlaymatId], references: [id], onDelete: SetNull)
}

model GameRoom {
  id             String     @id @default(uuid())
  code           String     @unique
  hostUserId     String?
  gameMode       GameMode   @default(COMMANDER)
  status         RoomStatus @default(LOBBY)
  isPrivate      Boolean    @default(false)
  passwordHash   String?
  createdAt      DateTime   @default(now())
  lastActivityAt DateTime   @default(now())

  host  User?      @relation("HostedRooms", fields: [hostUserId], references: [id], onDelete: SetNull)
  seats GameSeat[]
  logs  GameLog[]

  @@index([lastActivityAt])
  @@index([status])
}

model GameSeat {
  id             String   @id @default(uuid())
  roomId         String
  userId         String?
  guestName      String?
  seatIndex      Int
  deckSnapshotId String?
  joinedAt       DateTime @default(now())

  room         GameRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  deckSnapshot DeckSnapshot? @relation(fields: [deckSnapshotId], references: [id], onDelete: SetNull)
  logs         GameLog[]

  @@unique([roomId, seatIndex])
  @@index([userId])
}

/// Deck figé au lancement d'une partie : modifier le Deck source ne mute jamais
/// une partie en cours, et le snapshot est la base des replays.
model DeckSnapshot {
  id        String   @id @default(uuid())
  deckId    String?
  payload   Json
  createdAt DateTime @default(now())

  deck  Deck?      @relation(fields: [deckId], references: [id], onDelete: SetNull)
  seats GameSeat[]

  @@index([deckId])
}

model GameLog {
  id          String   @id @default(uuid())
  roomId      String
  seq         Int
  actorSeatId String?
  type        String
  payload     Json
  createdAt   DateTime @default(now())

  room  GameRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor GameSeat? @relation(fields: [actorSeatId], references: [id], onDelete: SetNull)

  @@unique([roomId, seq])
  @@index([roomId, createdAt])
}

/// Cache des réponses Archidekt, pour tenir le rate limit et éviter de retaper
/// leur API à chaque resync.
model ExternalDeckCache {
  id         String   @id @default(uuid())
  source     DeckSource
  externalId String
  payload    Json
  fetchedAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([fetchedAt])
}

/// Trace des ingestions de bulk Scryfall, pour ne pas retélécharger inutilement.
model IngestRun {
  id           String   @id @default(uuid())
  bulkType     String
  bulkUpdatedAt DateTime
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  cardsUpserted Int     @default(0)
  error        String?

  @@index([bulkType, bulkUpdatedAt])
}
