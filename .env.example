# --- Base ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=mtg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mtg
DATABASE_URL=postgresql://mtg:change-me@localhost:5432/mtg?schema=public

# --- Sessions --------------------------------------------------------------
# 32 octets en base64url : `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=change-me-please-32-bytes-minimum
COOKIE_DOMAIN=
# true derrière un reverse proxy TLS, false en dev http
COOKIE_SECURE=false

# --- Email (vérification, réinitialisation) --------------------------------
# Laisser vide en dev : les mails sont écrits dans les logs au lieu d'être envoyés.
SMTP_URL=
MAIL_FROM=no-reply@localhost

# --- Ingestion Scryfall ----------------------------------------------------
# Identifie ce déploiement auprès de Scryfall, comme leur documentation le demande.
SCRYFALL_USER_AGENT=mtg-vtt/0.1 (+https://example.org; contact@example.org)
# Ingestion au démarrage si la table Card est vide
INGEST_ON_BOOT=true
# Ingestion quotidienne (cron interne), heure UTC
INGEST_CRON_HOUR=4

# --- Archidekt -------------------------------------------------------------
ARCHIDEKT_USER_AGENT=mtg-vtt/0.1 (+https://example.org; contact@example.org)
ARCHIDEKT_RATE_PER_MIN=30
ARCHIDEKT_CACHE_TTL_SECONDS=900

# --- Moxfield --------------------------------------------------------------
# Désactivé par défaut, et ce n'est pas un oubli : Moxfield filtre les accès
# tiers par User-Agent inscrit sur liste blanche. La procédure est documentée
# dans docs/moxfield.md — en résumé, il faut la demander sur leur Discord et
# obtenir un User-Agent nominatif, que l'on renseigne ici tel qu'il a été
# accordé. Aucun contournement de Cloudflare n'est implémenté, et il ne faut
# pas en implémenter : un accès refusé se règle avec eux, pas contre eux.
MOXFIELD_API_ENABLED=false
# Format attendu : nom-du-deploiement/version (+url de contact)
#   ex. matable-mtg/0.1 (+https://matable.example; contact@matable.example)
# Le User-Agent autorise est NOMINATIF : il identifie le deploiement qui l'a
# obtenu et porte un contact, c'est tout l'objet de la liste blanche. Ne reprends
# jamais celui d'un autre operateur, et ne le publie pas dans une image Docker.
MOXFIELD_USER_AGENT=
# Inutilise pour l'instant : il ne sert qu'aux donnees privees d'un compte,
# chemin casse cote Moxfield (docs/moxfield.md, ticket moxfield-public#143).
MOXFIELD_API_TOKEN=
# Debit sortant et duree de cache. Le cache evite de redemander deux fois le
# meme deck : c'est le premier geste de bonne conduite sur un acces accorde.
MOXFIELD_RATE_PER_MIN=6
MOXFIELD_CACHE_TTL_SECONDS=3600
